FROM ghcr.io/cross-rs/x86_64-unknown-linux-musl:main

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install --no-install-recommends -y \
    clang llvm pkg-config libelf-dev zlib1g-dev curl ca-certificates file tar gzip && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /tmp/target-pkgs && cd /tmp/target-pkgs && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/elfutils-dev-0.191-r0.apk -o elfutils-dev.apk && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/zlib-dev-1.3.2-r0.apk -o zlib-dev.apk && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/zlib-static-1.3.2-r0.apk -o zlib-static.apk && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/zstd-dev-1.5.6-r2.apk -o zstd-dev.apk && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/zstd-static-1.5.6-r2.apk -o zstd-static.apk && \
    curl -fsSL https://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64/libbpf-dev-1.5.0-r0.apk -o libbpf-dev.apk && \
    for package in *.apk; do tar -xzf "$package" -C /usr/local/x86_64-linux-musl 2>/dev/null || true; done && \
    rm -rf /tmp/target-pkgs

RUN mv /usr/local/bin/x86_64-linux-musl-gcc /usr/local/bin/x86_64-linux-musl-gcc.real && \
    printf '#!/bin/sh\nfor arg in "$@"; do\n  if [ "$arg" = "-c" ] || [ "$arg" = "-E" ] || [ "$arg" = "-S" ]; then\n    exec /usr/local/bin/x86_64-linux-musl-gcc.real "$@"\n  fi\ndone\nexec /usr/local/bin/x86_64-linux-musl-gcc.real "$@" -lzstd -lz\n' > /usr/local/bin/x86_64-linux-musl-gcc && \
    chmod +x /usr/local/bin/x86_64-linux-musl-gcc

RUN file /usr/local/x86_64-linux-musl/usr/lib/libelf.a && \
    file /usr/local/x86_64-linux-musl/usr/lib/libz.a && \
    printf '#include <libelf.h>\n#include <zlib.h>\nint main(void) { return elf_version(EV_CURRENT) == EV_NONE; }\n' > /tmp/probe.c && \
    /usr/local/bin/x86_64-linux-musl-gcc -I/usr/local/x86_64-linux-musl/usr/include /tmp/probe.c \
      -L/usr/local/x86_64-linux-musl/usr/lib -lelf -lz -lzstd -o /tmp/probe && \
    file /tmp/probe && rm -f /tmp/probe.c /tmp/probe

ENV LIBBPF_SYS_EXTRA_CFLAGS="-I/usr/local/x86_64-linux-musl/usr/include"
ENV LIBBPF_SYS_LIBRARY_PATH_x86_64_unknown_linux_musl="/usr/local/x86_64-linux-musl/usr/lib"
ENV BPF_CLANG_EXTRA_CFLAGS="-I/usr/local/x86_64-linux-musl/usr/include"
