config agent 'main'
    option enabled '1'
    option interface 'br-lan'
    list interfaces 'br-lan'
    option controller_url 'http://127.0.0.1:8090'
    option token ''
    option poll_interval_ms '1000'
    option batch_interval_ms '1000'
    option max_flows '65536'
    option retry_buffer_seconds '60'
    option telemetry_retry_buffer_bytes '8388608'
    option tcp_idle_timeout_seconds '120'
    option udp_idle_timeout_seconds '30'
    option sample_enabled '1'
    option sample_max_packets_per_direction '4'
    option sample_max_bytes_per_packet '1024'
    option sample_max_bytes_per_flow '4096'
    option interface_counter_sanity_enabled '1'
    option interface_counter_min_bytes '65536'
    option interface_counter_max_unaccounted_ratio '4'
    option log_level 'info'
    option diagnostics_enabled '0'
    option update_channel 'stable'
