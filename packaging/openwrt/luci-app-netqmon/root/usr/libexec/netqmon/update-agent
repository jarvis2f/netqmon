#!/bin/sh
set -u

MANIFEST_URL="${NETQMON_UPDATE_MANIFEST_URL:-}"
RELEASES_API_URL="https://api.github.com/repos/jarvis2f/netqmon/releases?per_page=100"
TMP_DIR="${TMPDIR:-/tmp}/netqmon-update"
MANIFEST="$TMP_DIR/manifest.json"
RELEASES="$TMP_DIR/releases.json"
SERVICE=/etc/init.d/netqmon
AGENT=/usr/bin/netqmon-agent

json_escape() {
    printf '%s' "$1" | sed ':a;N;$!ba;s/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

json_string() {
    printf '"%s"' "$(json_escape "$1")"
}

fail() {
    printf '{"ok":false,'
    emit_common_fields
    printf ',"error":'
    json_string "$1"
    printf '}\n'
    exit 0
}

current_version() {
    local manager version
    manager="$(package_manager 2>/dev/null || true)"
    if [ "$manager" = apk ] && [ -x "$AGENT" ]; then
        version="$("$AGENT" --version 2>/dev/null | awk '{print $2; exit}')"
        if [ -n "$version" ]; then
            printf '%s' "$version"
            return 0
        fi
    fi
    version=
    case "$manager" in
        opkg)
            version="$(opkg list-installed netqmon-agent 2>/dev/null | awk '$1 == "netqmon-agent" {print $3; exit}')"
            ;;
        apk)
            version="$(apk info -v netqmon-agent 2>/dev/null | awk 'NR == 1 {sub(/^netqmon-agent-/, ""); print; exit}')"
            ;;
    esac
    if [ -n "$version" ]; then
        printf '%s' "$version"
        return 0
    fi
    if [ -x "$AGENT" ]; then
        "$AGENT" --version 2>/dev/null | awk '{print $2; exit}'
    fi
}

apk_release_version() {
    local version="$1" base suffix stage number
    case "$version" in
        *-*)
            base="${version%%-*}"
            suffix="${version#*-}"
            stage="${suffix%%.*}"
            number="${suffix#*.}"
            case "$stage" in alpha|beta|rc) ;; *) return 1 ;; esac
            [ "$number" != "$suffix" ] || return 1
            case "$number" in ''|*[!0-9]*) return 1 ;; esac
            printf '%s_%s%s' "$base" "$stage" "$number"
            ;;
        *) printf '%s' "$version" ;;
    esac
}

package_manager() {
    if command -v opkg >/dev/null 2>&1; then
        printf 'opkg'
    elif command -v apk >/dev/null 2>&1; then
        printf 'apk'
    else
        return 1
    fi
}

package_format() {
    local manager
    manager="$(package_manager)" || return 1
    case "$manager" in
        opkg) printf 'ipk' ;;
        apk) printf 'apk' ;;
        *) return 1 ;;
    esac
}

openwrt_arch() {
    local manager
    manager="$(package_manager)" || return 1
    case "$manager" in
        opkg)
            opkg print-architecture 2>/dev/null | awk '
                NF >= 3 && $2 != "all" && $2 != "noarch" && $3 >= best {
                    arch = $2
                    best = $3
                }
                END { print arch }
            '
            ;;
        apk)
            apk --print-arch 2>/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

update_channel() {
    local channel
    channel="${NETQMON_UPDATE_CHANNEL:-$(uci -q get netqmon.main.update_channel || echo stable)}"
    case "$channel" in
        stable|beta) printf '%s' "$channel" ;;
        *) fail "unsupported update channel" ;;
    esac
}

configured_update_channel() {
    printf '%s' "${NETQMON_UPDATE_CHANNEL:-$(uci -q get netqmon.main.update_channel || echo stable)}"
}

emit_common_fields() {
    printf '"current_version":'
    json_string "$(current_version)"
    printf ',"latest_version":'
    json_string "${latest_version:-}"
    printf ',"channel":'
    json_string "${channel:-$(configured_update_channel)}"
    printf ',"architecture":'
    json_string "${arch:-$(openwrt_arch)}"
    printf ',"package_format":'
    json_string "${format:-$(package_format)}"
    printf ',"update_available":%s' "${update_available:-false}"
    printf ',"last_check":'
    json_string "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

status_call() {
    channel="$(update_channel)"
    arch="$(openwrt_arch)"
    printf '{"ok":true,'
    emit_common_fields
    printf '}\n'
}

release_manifest_url() {
    local output index tag prerelease draft asset_name
    channel="$(update_channel)"
    mkdir -p "$TMP_DIR" || fail "failed to create update workspace"
    output="$(wget -O "$RELEASES" "$RELEASES_API_URL" 2>&1)" || return 1
    [ -s "$RELEASES" ] || return 1

    index=0
    while [ "$index" -lt 100 ]; do
        tag="$(jsonfilter -i "$RELEASES" -e "@[$index].tag_name" 2>/dev/null | head -n 1)"
        [ -n "$tag" ] || break
        prerelease="$(jsonfilter -i "$RELEASES" -e "@[$index].prerelease" 2>/dev/null | head -n 1)"
        draft="$(jsonfilter -i "$RELEASES" -e "@[$index].draft" 2>/dev/null | head -n 1)"
        asset_name="$(jsonfilter -i "$RELEASES" -e "@[$index].assets[@.name='openwrt-agent-manifest.json'].name" 2>/dev/null | head -n 1)"

        if [ "$draft" != "true" ] && [ "$asset_name" = "openwrt-agent-manifest.json" ]; then
            if { [ "$channel" = "beta" ] && [ "$prerelease" = "true" ]; } || \
                { [ "$channel" = "stable" ] && [ "$prerelease" = "false" ]; }; then
                printf 'https://github.com/jarvis2f/netqmon/releases/download/%s/openwrt-agent-manifest.json' "$tag"
                return 0
            fi
        fi
        index=$((index + 1))
    done
    return 1
}

download_manifest() {
    local output resolved_url
    mkdir -p "$TMP_DIR" || fail "failed to create update workspace"
    if [ -n "$MANIFEST_URL" ]; then
        resolved_url="$MANIFEST_URL"
    else
        resolved_url="$(release_manifest_url)" || fail "no ${channel:-$(configured_update_channel)} release with an OpenWrt manifest was found"
        MANIFEST_URL="$resolved_url"
    fi
    output="$(wget -O "$MANIFEST" "$resolved_url" 2>&1)" || fail "failed to download release manifest from $resolved_url: $output"
}

manifest_field() {
    local channel="$1" arch="$2" format="$3" expr="$4"
    jsonfilter -i "$MANIFEST" -e "@.channels.${channel}.packages[@.name='netqmon-agent' && @.openwrt_arch='${arch}' && @.package_format='${format}'].${expr}" 2>/dev/null | head -n 1
}

channel_field() {
    local channel="$1" expr="$2"
    jsonfilter -i "$MANIFEST" -e "@.channels.${channel}.${expr}" 2>/dev/null | head -n 1
}

validate_package_url() {
    case "$format:$1" in
        ipk:https://github.com/jarvis2f/netqmon/releases/download/*/netqmon-agent_*.ipk) return 0 ;;
        apk:https://github.com/jarvis2f/netqmon/releases/download/*/netqmon-agent-*.apk) return 0 ;;
        *) return 1 ;;
    esac
}

resolve_update() {
    channel="$(update_channel)"
    format="$(package_format)" || fail "no supported OpenWrt package manager was found"
    arch="$(openwrt_arch)"
    [ -n "$arch" ] || fail "failed to detect OpenWrt architecture"

    latest_version="$(channel_field "$channel" version)"
    package_url="$(manifest_field "$channel" "$arch" "$format" url)"
    sha256="$(manifest_field "$channel" "$arch" "$format" sha256)"
    package_arch="$(manifest_field "$channel" "$arch" "$format" openwrt_arch)"
    latest_package_version="$(manifest_field "$channel" "$arch" "$format" version)"

    [ -n "$latest_version" ] || fail "manifest channel has no version"
    [ "$package_arch" = "$arch" ] || fail "manifest has no package for this architecture ($arch, $format)"
    [ -n "$package_url" ] || fail "manifest package has no URL"
    [ -n "$sha256" ] || fail "manifest package has no SHA256"
    [ -n "$latest_package_version" ] || fail "manifest package has no version"
    validate_package_url "$package_url" || fail "manifest package URL is not trusted"

    current="$(current_version)"
    case "$(package_manager)" in
        opkg)
            if opkg compare-versions "$latest_package_version" '>' "$current" >/dev/null 2>&1; then
                update_available=true
            else
                update_available=false
            fi
            ;;
        apk)
            # Older beta APKs used a commit hash as the package version, whose
            # ordering is unrelated to release order. Compare the Agent's
            # embedded release version to the manifest channel version instead.
            if [ -x "$AGENT" ]; then
                installed_release="$("$AGENT" --version 2>/dev/null | awk '{print $2; exit}')"
            else
                installed_release=
            fi
            [ -n "$installed_release" ] || fail "cannot determine installed agent release version"
            latest_comparable="$(apk_release_version "$latest_version")" || fail "unsupported manifest release version"
            installed_comparable="$(apk_release_version "$installed_release")" || fail "unsupported installed agent release version"
            comparison="$(apk version -t "$latest_comparable" "$installed_comparable" 2>/dev/null)" || fail "failed to compare agent release versions"
            case "$comparison" in '<'|'='|'>') ;; *) fail "failed to compare agent release versions" ;; esac
            if [ "$comparison" = ">" ]; then
                update_available=true
            elif [ "$comparison" = "=" ]; then
                # Keep package revision upgrades working once both releases
                # use the canonical APK version format.
                installed_package="$(apk list --installed netqmon-agent 2>/dev/null | awk '$1 ~ /^netqmon-agent-/ {sub(/^netqmon-agent-/, "", $1); print $1; exit}')"
                case "$installed_package" in
                    "${installed_comparable}"-r*)
                        package_comparison="$(apk version -t "$latest_package_version" "$installed_package" 2>/dev/null)" || fail "failed to compare agent package versions"
                        case "$package_comparison" in '<'|'='|'>') ;; *) fail "failed to compare agent package versions" ;; esac
                        [ "$package_comparison" = ">" ] && update_available=true || update_available=false
                        ;;
                    *) update_available=false ;;
                esac
            else
                update_available=false
            fi
            ;;
    esac
}

check_call() {
    download_manifest
    resolve_update
    printf '{"ok":true,'
    emit_common_fields
    printf '}\n'
}

apply_call() {
    local actual install_log install_rc manager package rc
    download_manifest
    resolve_update
    [ "$update_available" = true ] || fail "no newer package is available on the selected update channel"
    manager="$(package_manager)"
    package="$TMP_DIR/netqmon-agent.$format"
    wget -q -O "$package" "$package_url" || fail "failed to download agent package"
    actual="$(sha256sum "$package" | awk '{print $1}')"
    [ "$actual" = "$sha256" ] || fail "downloaded package checksum mismatch"

    "$SERVICE" stop >/dev/null 2>&1 || true
    if [ "$manager" = "opkg" ]; then
        install_log=/tmp/netqmon-opkg.log
        opkg install "$package" >"$install_log" 2>&1
        install_rc=$?
    else
        install_log=/tmp/netqmon-apk.log
        apk add --allow-untrusted "$package" >"$install_log" 2>&1
        install_rc=$?
    fi
    if [ "$install_rc" -ne 0 ]; then
        "$SERVICE" start >/dev/null 2>&1 || true
        fail "$manager install failed; existing agent was restarted"
    fi
    "$SERVICE" start >/dev/null 2>&1 || true
    "$AGENT" doctor >/tmp/netqmon-doctor.log 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || fail "agent updated but doctor reported a failure"

    printf '{"ok":true,'
    emit_common_fields
    printf '}\n'
}

case "${1:-}" in
    status) status_call ;;
    check) check_call ;;
    apply) apply_call ;;
    *) fail "usage: update-agent status|check|apply" ;;
esac
